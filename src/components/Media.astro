---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { onAir, talks, articles } from '../data/content';
import OrgMark from './OrgMark.astro';
import Appearances from './Appearances.astro';
import { getTalkViews } from '../lib/youtube';

// Thumbnails, downloaded once and served optimised: BFM episode images and YouTube thumbnails.
// Sources and provenance are embedded in each file under assets/media/.
const thumbs = import.meta.glob<ImageMetadata>('../../assets/media/*', { eager: true, import: 'default' });
const thumb = (name: string) => thumbs[`../../assets/media/${name}`];

// "27 Feb 2025" → "2025-02-27" for <time datetime>; "37 min" → "PT37M".
const MONTHS: Record<string, string> = {
  Jan: '01', Feb: '02', Mar: '03', Apr: '04', May: '05', Jun: '06',
  Jul: '07', Aug: '08', Sep: '09', Oct: '10', Nov: '11', Dec: '12',
};
const isoDate = (d: string) => {
  const [day, mon, year] = d.split(' ');
  return `${year}-${MONTHS[mon]}-${day.padStart(2, '0')}`;
};
const isoLength = (len: string) => `PT${parseInt(len, 10)}M`;

// YouTube only has HD thumbnails for some videos; the rest are 4:3 with letterbox bars, cropped tighter.
const HD_THUMBS = new Set(['UjIK6tLkzZY', 'OtYHCp77dEs', 'fds4s_FjLlA']);

// The appearances block shows only when the CMS holds at least one visible entry.
const hasAppearances = (await getCollection('appearances', ({ data }) => !data.draft)).length > 0;

// YouTube view counts, per talk and in total; the total cites home note 10 (src/pages/index.astro).
const talkViews = await getTalkViews();
const fmt = (n: number) => n.toLocaleString('en-US');
const VIEWS_NOTE = 10;
---

<section id="media" class="media on-plate" aria-labelledby="media-heading">
  <h2 id="media-heading" class="section-heading">Media</h2>

  <div class="block">
    <div class="block-head">
      <h3 class="block-heading">On air</h3>
      <p class="block-sub">BFM 89.9</p>
    </div>

    <ul class="episodes">
      {
        onAir.map((ep) => (
          <li class="episode" data-reveal>
            <figure class="frame ep-frame">
              <Image
                src={thumb(`bfm-${isoDate(ep.date)}.png`)}
                alt=""
                widths={[480, 800, 1178]}
                sizes="(min-width: 1024px) 24vw, 100vw"
                format="webp"
                quality={80}
                loading="lazy"
                decoding="async"
              />
              <span class="play" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 5.5v13L18.5 12Z" fill="currentColor" /></svg>
              </span>
            </figure>
            <p class="ep-meta tabular">
              <span>
                <time datetime={isoDate(ep.date)}>{ep.date}</time>
                <span aria-hidden="true">{' · '}</span>
                <span class="ep-show">{ep.show}</span>
              </span>
              <time datetime={isoLength(ep.length)}>{ep.length}</time>
            </p>
            <h4 class="ep-title">
              <a href={ep.url} target="_blank" rel="noopener">
                {ep.title}
                <span class="sr-only"> (BFM 89.9, opens in a new tab)</span>
              </a>
            </h4>
            <span class="ep-listen" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M7 4.8v14.4L19 12Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
              </svg>
              Listen on bfm.my
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="block">
    <div class="block-head">
      <h3 class="block-heading">In the press</h3>
      <p class="block-sub">Interviews and features</p>
    </div>

    <ul class="articles">
      {
        articles.map((a) => (
          <li class="article" data-reveal>
            <a class="article-link" href={a.url} target="_blank" rel="noopener">
              <span class="article-source">
                <OrgMark name={a.outlet} size="sm" />
                <span class="article-meta tabular">
                  <span class="article-outlet">{a.outlet}</span>
                  <time datetime={isoDate(a.date)}>{a.date}</time>
                </span>
              </span>
              <span class="article-title">{a.title}</span>
              <svg class="article-arrow" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.6" />
              </svg>
              <span class="sr-only"> ({a.outlet}, opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {
    hasAppearances && (
      <div class="block">
        <div class="block-head">
          <h3 class="block-heading">Public appearances</h3>
          <p class="block-sub">On Instagram and LinkedIn</p>
        </div>
        <Appearances />
      </div>
    )
  }

  <div class="block">
    <div class="block-head">
      <h3 class="block-heading">Selected talks</h3>
      <p class="block-sub">Recorded on YouTube</p>
      <p class="views-total">
        <span class="views-total-value tabular">
          {fmt(talkViews.total)}<a class="note-ref" href={`#note-${VIEWS_NOTE}`} aria-label={`Note ${VIEWS_NOTE}`}
            >{VIEWS_NOTE}</a
          >
        </span>
        <span class="views-total-label">views in total</span>
      </p>
    </div>

    <ul class="talks">
      {
        talks.map((t) => (
          <li class="talk" data-reveal>
            <a class="talk-link" href={`https://www.youtube.com/watch?v=${t.youtube}`} target="_blank" rel="noopener">
              <span class:list={['frame', 'talk-frame', { letterboxed: !HD_THUMBS.has(t.youtube) }]}>
                <Image
                  src={thumb(`yt-${t.youtube}.jpg`)}
                  alt=""
                  widths={[320, 480]}
                  sizes="(min-width: 1024px) 24vw, 40vw"
                  format="webp"
                  quality={78}
                  loading="lazy"
                  decoding="async"
                />
                <span class="play" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5.5v13L18.5 12Z" fill="currentColor" /></svg>
                </span>
              </span>
              <span class="talk-text">
                <span class="talk-meta tabular">
                  <time datetime={isoDate(t.date)}>{t.date}</time>
                  <span aria-hidden="true">{' · '}</span>
                  {t.venue}
                </span>
                <span class="talk-title">{t.title}</span>
                <span class="talk-views tabular">{fmt(talkViews.views[t.youtube] ?? 0)} views</span>
                <span class="sr-only"> (YouTube, opens in a new tab)</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* The page's one rhythm break after the white sections: a full-bleed ultramarine plate,
     like the coloured divider spread of a printed report. */
  .media {
    --plate-rule-soft: color-mix(in oklab, var(--color-plate-ink) 42%, transparent);
    --plate-underline: color-mix(in oklab, #fff 38%, transparent);
    padding: calc(110 * var(--u)) var(--gutter) calc(150 * var(--u));
    background: var(--color-plate);
    color: #fff;
    scroll-margin-top: var(--nav-h);
  }

  .media .section-heading {
    margin: 0 0 calc(84 * var(--u));
  }

  .block {
    display: grid;
    grid-template-columns: calc(411 * var(--u)) 1fr;
    align-items: start;
    border-top: max(calc(2 * var(--u)), 1px) solid #fff;
  }

  .block + .block {
    margin-top: calc(140 * var(--u));
  }

  .block-head {
    padding-top: calc(28 * var(--u));
  }

  .block-heading {
    margin: 0;
    font-weight: 700;
    font-size: max(calc(30 * var(--u)), 18px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .block-sub {
    margin: calc(8 * var(--u)) 0 0;
    font-weight: 500;
    font-size: max(calc(22 * var(--u)), 14px);
    color: var(--color-plate-ink);
  }

  /* Thumbnails: square frames on the plate, a slow zoom on hover, a white play mark. */
  .frame {
    position: relative;
    display: block;
    margin: 0;
    overflow: hidden;
    background: var(--color-plate-deep);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out-expo);
  }

  .play {
    position: absolute;
    left: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    width: max(calc(64 * var(--u)), 34px);
    height: max(calc(64 * var(--u)), 34px);
    background: #fff;
    color: var(--color-plate);
    transition: background-color 220ms var(--ease-out-expo), color 220ms var(--ease-out-expo);
  }

  .play svg {
    width: 46%;
    height: 46%;
  }

  /* On air: the dominant element, three episodes as a row of ruled columns. */
  .episodes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: calc(96 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .episode {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: calc(40 * var(--u)) 0 calc(8 * var(--u));
  }

  /* Column rules sit in the gutters, so every episode gets the same width and its image the same height. */
  .episode + .episode::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(-48 * var(--u));
    border-left: 1px solid var(--plate-rule-soft);
  }

  .ep-frame {
    aspect-ratio: 1178 / 617;
    margin-bottom: calc(30 * var(--u));
  }

  .episode:hover .frame :global(img) {
    transform: scale(1.04);
  }

  .episode:hover .play {
    background: var(--color-plate-ink);
  }

  .ep-meta {
    display: flex;
    justify-content: space-between;
    gap: 1em;
    margin: 0;
    font-weight: 500;
    font-size: max(calc(24 * var(--u)), 14px);
    color: var(--color-plate-ink);
  }

  .ep-show {
    color: #fff;
    font-weight: 600;
  }

  .ep-title {
    margin: calc(36 * var(--u)) 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 90%;
    font-size: max(calc(62 * var(--u)), 28px);
    line-height: 1.02;
    letter-spacing: -0.022em;
  }

  .ep-title a {
    color: #fff;
    text-decoration-line: underline;
    text-decoration-thickness: max(calc(3 * var(--u)), 1px);
    text-decoration-color: var(--plate-underline);
    text-underline-offset: 0.12em;
    transition: text-decoration-color 220ms var(--ease-out-expo);
  }

  /* The whole column is the target; the title stays the link. */
  .ep-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .episode:hover .ep-title a,
  .ep-title a:focus-visible {
    text-decoration-color: #fff;
  }

  .ep-listen {
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin-top: auto;
    padding-top: calc(48 * var(--u));
    font-weight: 500;
    font-size: max(calc(22 * var(--u)), 14px);
    color: var(--color-plate-ink);
    transition: color 220ms var(--ease-out-expo);
  }

  .ep-listen svg {
    width: max(calc(34 * var(--u)), 20px);
    height: max(calc(34 * var(--u)), 20px);
    transition: transform 260ms var(--ease-out-expo);
  }

  .episode:hover .ep-listen {
    color: #fff;
  }

  .episode:hover .ep-listen svg {
    transform: translateX(5px);
  }

  /* In the press: ruled rows, outlet and date at left, the headline as the link. */
  .articles {
    margin: 0;
    padding: calc(16 * var(--u)) 0 0;
    list-style: none;
  }

  .article + .article {
    border-top: 1px solid var(--plate-rule-soft);
  }

  .article-link {
    display: grid;
    grid-template-columns: calc(380 * var(--u)) 1fr auto;
    align-items: center;
    column-gap: calc(40 * var(--u));
    padding-block: calc(26 * var(--u));
    color: #fff;
    text-decoration: none;
  }

  .article-source {
    display: flex;
    align-items: center;
    gap: max(calc(16 * var(--u)), 10px);
  }

  .article-meta {
    display: grid;
    gap: 0.15em;
    font-size: max(calc(21 * var(--u)), 13.5px);
    color: var(--color-plate-ink);
  }

  .article-outlet {
    font-weight: 600;
    color: #fff;
  }

  .article-title {
    font-weight: 700;
    font-stretch: 95%;
    font-size: max(calc(36 * var(--u)), 18px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: max(calc(2 * var(--u)), 1px);
    text-underline-offset: 0.16em;
    transition: text-decoration-color 220ms var(--ease-out-expo);
  }

  .article-arrow {
    width: max(calc(36 * var(--u)), 20px);
    height: max(calc(36 * var(--u)), 20px);
    color: var(--color-plate-ink);
    transition: transform 260ms var(--ease-out-expo), color 220ms var(--ease-out-expo);
  }

  .article-link:hover .article-title,
  .article-link:focus-visible .article-title {
    text-decoration-color: #fff;
  }

  .article-link:hover .article-arrow {
    color: #fff;
    transform: translate(3px, -3px);
  }

  /* Selected talks: a contact sheet of the recordings. */
  .talks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(56 * var(--u)) calc(48 * var(--u));
    margin: 0;
    padding: calc(40 * var(--u)) 0 0;
    list-style: none;
  }

  .talk-link {
    display: grid;
    gap: calc(20 * var(--u));
    color: #fff;
    text-decoration: none;
  }

  .talk-frame {
    aspect-ratio: 16 / 9;
  }

  .talk-frame.letterboxed :global(img) {
    transform: scale(1.12);
  }

  .talk-link:hover .frame :global(img) {
    transform: scale(1.05);
  }

  .talk-link:hover .talk-frame.letterboxed :global(img) {
    transform: scale(1.17);
  }

  .talk-link:hover .play {
    background: var(--color-plate-ink);
  }

  .talk-text {
    display: grid;
    gap: calc(8 * var(--u));
  }

  .talk-meta {
    font-weight: 500;
    font-size: max(calc(21 * var(--u)), 13.5px);
    line-height: 1.35;
    color: var(--color-plate-ink);
  }

  .views-total {
    display: grid;
    gap: calc(4 * var(--u));
    margin: calc(48 * var(--u)) 0 0;
  }

  .views-total-value {
    font-weight: 800;
    font-stretch: 90%;
    font-size: max(calc(84 * var(--u)), 40px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .views-total-value .note-ref {
    font-size: 0.3em;
    vertical-align: 1.9em;
  }

  .views-total-label {
    font-weight: 500;
    font-size: max(calc(22 * var(--u)), 14px);
    color: var(--color-plate-ink);
  }

  .talk-views {
    font-weight: 500;
    font-size: max(calc(21 * var(--u)), 13.5px);
    color: var(--color-plate-ink);
  }

  .talk-title {
    font-weight: 600;
    font-size: max(calc(28 * var(--u)), 16px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 220ms var(--ease-out-expo);
  }

  .talk-link:hover .talk-title,
  .talk-link:focus-visible .talk-title {
    text-decoration-color: #fff;
  }

  @media (max-width: 1023px) {
    .media {
      padding: 56px var(--gutter) 64px;
    }

    .media .section-heading {
      margin-bottom: 32px;
    }

    .block {
      grid-template-columns: 1fr;
      border-top-width: 2px;
    }

    .block + .block {
      margin-top: 56px;
    }

    .block-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding-top: 16px;
    }

    .block-sub {
      margin: 0;
    }

    .block-head {
      flex-wrap: wrap;
    }

    .views-total {
      flex-basis: 100%;
      grid-auto-flow: column;
      justify-content: start;
      align-items: baseline;
      gap: 10px;
      margin-top: 8px;
    }

    .views-total-value {
      font-size: 40px;
    }

    .talk-views {
      font-size: 13px;
    }

    .episodes {
      grid-template-columns: 1fr;
      margin-top: 8px;
    }

    .episode {
      padding: 20px 0 24px;
    }

    .episode + .episode::before {
      display: none;
    }

    .episode + .episode {
      border-top: 1px solid var(--plate-rule-soft);
    }

    .ep-frame {
      margin-bottom: 16px;
    }

    .ep-title {
      margin-top: 14px;
      font-size: clamp(26px, 7.2vw, 38px);
      text-wrap: pretty;
    }

    .ep-listen {
      padding-top: 16px;
    }

    .article-link {
      grid-template-columns: 1fr auto;
      row-gap: 10px;
      padding-block: 16px;
    }

    .article-source {
      grid-column: 1 / -1;
    }

    .article-title {
      font-size: 18px;
    }

    .talks {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 8px;
    }

    .talk + .talk {
      border-top: 1px solid var(--plate-rule-soft);
    }

    .talk-link {
      grid-template-columns: 40% 1fr;
      align-items: start;
      gap: 14px;
      padding-block: 14px;
    }

    .talk-text {
      gap: 4px;
    }

    .talk-meta {
      font-size: 13px;
    }

    .talk-title {
      font-size: 16px;
    }
  }
</style>
