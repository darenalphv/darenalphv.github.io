---
// Media kit: speaker photos (Pages CMS `speakerPhotos`). The page shows resized previews; the
// download is the uploaded original, at full size.
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const files = import.meta.glob<ImageMetadata>('../../assets/speaker-photos/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const fileName = (path: string) => path.split('/').pop()!.toLowerCase();
const imageFor = (path: string) => {
  const key = Object.keys(files).find((k) => fileName(k) === fileName(path));
  return key ? { meta: files[key], name: fileName(key) } : undefined;
};

const kb = (name: string) => Math.round(statSync(join(process.cwd(), 'src/assets/speaker-photos', name)).size / 1024);
const fmt = (n: number) => n.toLocaleString('en-US');

const photos = (await getCollection('speakerPhotos', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .flatMap((entry) => {
    const image = imageFor(entry.data.image);
    if (!image) return [];
    const { width, height, format } = image.meta;
    const shape = width > height * 1.05 ? 'Landscape' : height > width * 1.05 ? 'Portrait' : 'Square';
    return [{ ...entry.data, ...image, shape, size: kb(image.name), download: `daren-tan-${image.name}`, format }];
  });
---

<section id="photos" class="kit-block" aria-labelledby="photos-heading">
  <div class="side">
    <h2 id="photos-heading" class="side-heading">Speaker photos</h2>
    <p class="side-sub">Full-size downloads, for posters, event pages and press.</p>
  </div>
  <ul class="photos">
    {
      photos.map((photo) => (
        <li class:list={['photo', photo.shape.toLowerCase()]}>
          <figure>
            <Image
              src={photo.meta}
              alt={`Daren Tan. ${photo.caption}.`}
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 1024px) 30vw, 100vw"
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="caption">{photo.caption}</span>
              {photo.credit && <span class="credit">Photo: {photo.credit}</span>}
              <span class="specs tabular">
                {photo.shape} · {fmt(photo.meta.width)} × {fmt(photo.meta.height)} px · {photo.format.toUpperCase()}, {fmt(photo.size)} KB
              </span>
            </figcaption>
          </figure>
          <a class="kit-btn" href={photo.meta.src} download={photo.download}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            Download
            <span class="sr-only"> {photo.shape.toLowerCase()} photo: {photo.caption}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(72 * var(--u)) calc(48 * var(--u));
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photo {
    display: grid;
    gap: calc(20 * var(--u));
    justify-items: start;
  }

  figure {
    margin: 0;
    width: 100%;
  }

  /* Photographs are never framed: they sit on the page at their own proportions. */
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-stage);
  }

  figcaption {
    display: grid;
    gap: 0.3em;
    margin-top: calc(18 * var(--u));
  }

  .caption {
    font-weight: 600;
    font-size: max(calc(24 * var(--u)), 15px);
    line-height: 1.35;
  }

  .credit,
  .specs {
    font-size: max(calc(20 * var(--u)), 13.5px);
    color: var(--color-ink-2);
  }

  @media (max-width: 1023px) {
    .photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 16px;
    }
  }

  @media (max-width: 560px) {
    .photos {
      grid-template-columns: 1fr;
    }
  }
</style>
