---
// Notes to the figures. Every superscript on a page links to #note-<n> here.
interface Props {
  notes: ReadonlyArray<{ n: number; text: string }>;
  heading?: string;
}
const { notes, heading = 'Notes' } = Astro.props;
---

<section class="notes" aria-labelledby="notes-heading">
  <h2 id="notes-heading" class="notes-heading">{heading}</h2>
  <ol>
    {
      notes.map((note) => (
        <li id={`note-${note.n}`}>
          <span class="n tabular">{note.n}</span>
          <p>{note.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .notes {
    display: grid;
    grid-template-columns: calc(411 * var(--u)) 1fr;
    column-gap: 0;
    padding: calc(90 * var(--u)) var(--gutter);
    border-top: 1px solid var(--color-rule-soft);
  }

  .notes-heading {
    margin: 0;
    font-weight: 700;
    font-size: max(calc(30 * var(--u)), 18px);
    letter-spacing: -0.01em;
  }

  ol {
    columns: 2;
    column-gap: calc(90 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    break-inside: avoid;
    padding-block: 0.7em;
    border-top: 1px solid var(--color-rule-soft);
    font-size: max(calc(20 * var(--u)), 13.5px);
    line-height: 1.5;
    color: var(--color-ink-2);
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  li:target {
    background: color-mix(in oklab, var(--color-plate) 8%, transparent);
  }

  .n {
    font-weight: 700;
    color: var(--color-ink);
  }

  p {
    margin: 0;
    max-width: 62ch;
  }

  @media (max-width: 1023px) {
    .notes {
      grid-template-columns: 1fr;
      row-gap: 18px;
      padding: 48px var(--gutter);
    }

    ol {
      columns: 1;
    }
  }
</style>
