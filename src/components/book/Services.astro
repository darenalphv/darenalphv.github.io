---
// Booking pages: one block per service, with what it covers and a ruled price list.
// Each "Enquire" button picks its option in the enquiry form below (Enquiry.astro).
import { price, type Market } from '../../data/rates';

interface Props {
  market: Market;
}
const { market } = Astro.props;
---

{
  market.services.map((service) => (
    <section id={service.id} class="kit-block" aria-labelledby={`${service.id}-heading`}>
      <div class="side">
        <h2 id={`${service.id}-heading`} class="side-heading">
          {service.name}
        </h2>
        <p class="side-sub">{service.sub}</p>
      </div>

      <div class="service">
        <div class="service-head">
          <p class="intro">
            {service.intro}
            {service.id === 'keynotes' && (
              <>
                {' '}
                Bios and photos for your programme are in the <a href="/media-kit/">media kit</a>.
              </>
            )}
          </p>
          <div class="topics">
            <h3 class="topics-label">{service.topicsLabel}</h3>
            <ul>
              {service.topics.map((topic) => (
                <li>
                  {topic.title}
                  {topic.where && <span class="where">{topic.where}</span>}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <ul class="options" aria-label={`${service.name} prices`}>
          {service.options.map((option) => (
            <li class="option">
              <div class="option-head">
                <h3 class="option-name">{option.name}</h3>
                <p class="option-detail">{option.detail}</p>
              </div>
              <p class="option-price">
                {option.from && <span class="from">From</span>}
                <span class="amount tabular">{price(market, option.amount)}</span>
                <span class="unit">{option.unit}</span>
              </p>
              <a class="kit-btn enquire" href="#enquire" data-pick={option.id}>
                Enquire
                <span class="sr-only"> about the {option.name.toLowerCase()}</span>
              </a>
            </li>
          ))}
        </ul>

        {service.footnote && <p class="footnote">{service.footnote}</p>}
      </div>
    </section>
  ))
}

<style>
  .service-head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: calc(90 * var(--u));
    align-items: start;
    margin-bottom: calc(56 * var(--u));
  }

  .intro {
    max-width: 44ch;
    margin: 0;
    font-size: max(calc(34 * var(--u)), 18px);
    line-height: 1.45;
    letter-spacing: -0.005em;
  }

  .intro a {
    color: inherit;
  }

  .intro a:hover {
    color: var(--color-plate);
  }

  .topics-label {
    margin: 0 0 calc(12 * var(--u));
    font-weight: 700;
    font-size: max(calc(22 * var(--u)), 14px);
    line-height: 1.3;
  }

  .topics ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-rule-soft);
  }

  .topics li {
    display: grid;
    gap: 0.2em;
    padding-block: calc(14 * var(--u));
    border-top: 1px solid var(--color-rule-soft);
    font-size: max(calc(24 * var(--u)), 15px);
    line-height: 1.4;
  }

  .where {
    font-size: max(calc(20 * var(--u)), 13.5px);
    color: var(--color-ink-2);
  }

  /* The price list: ruled rows of option, price and an enquire button. */
  .options {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-soft);
  }

  .option {
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(520 * var(--u)) auto;
    grid-template-areas: 'head price action';
    gap: calc(40 * var(--u));
    align-items: center;
    padding-block: calc(32 * var(--u));
    border-bottom: 1px solid var(--color-rule-soft);
  }

  .option-head {
    grid-area: head;
  }

  .option-name {
    margin: 0;
    font-weight: 800;
    font-stretch: 90%;
    font-size: max(calc(40 * var(--u)), 22px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .option-detail {
    margin: calc(10 * var(--u)) 0 0;
    max-width: 52ch;
    font-size: max(calc(22 * var(--u)), 14px);
    line-height: 1.45;
    color: var(--color-ink-2);
  }

  .option-price {
    grid-area: price;
    display: grid;
    justify-items: start;
    margin: 0;
  }

  .from,
  .unit {
    font-weight: 500;
    font-size: max(calc(20 * var(--u)), 13.5px);
    line-height: 1.3;
    color: var(--color-ink-2);
  }

  .amount {
    font-weight: 800;
    font-stretch: 90%;
    font-size: max(calc(56 * var(--u)), 28px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .enquire {
    grid-area: action;
    min-width: 8em;
  }

  .footnote {
    margin: calc(24 * var(--u)) 0 0;
    max-width: 62ch;
    font-size: max(calc(22 * var(--u)), 14px);
    line-height: 1.45;
    color: var(--color-ink-2);
  }

  @media (max-width: 1023px) {
    .service-head {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 28px;
    }

    .topics li {
      padding-block: 10px;
    }

    .option {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'head head'
        'price action';
      gap: 14px 16px;
      align-items: end;
      padding-block: 22px;
    }

    .enquire {
      min-width: 0;
    }
  }
</style>
