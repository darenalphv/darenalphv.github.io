---
import { LINKEDIN, WHATSAPP, nav, person } from '../data/content';

const onKit = Astro.url.pathname.startsWith('/media-kit');
---

<header class="site-header" data-site-header>
  <a href="/" class="wordmark" aria-label={`${person.name}, home`}>{person.name}</a>

  <nav class="site-nav" aria-label="Sections">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>

  <button class="contents-toggle" type="button" popovertarget="contents" aria-haspopup="true">
    Contents
  </button>

  <a class="header-kit" href="/media-kit/" aria-current={onKit ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    Media kit
  </a>

  <a class="btn-whatsapp header-wa" href={WHATSAPP} rel="noopener" target="_blank">
    Message on WhatsApp
  </a>

  <a class="btn-linkedin header-cta" href={LINKEDIN} rel="me noopener" target="_blank">
    Connect on LinkedIn
  </a>
</header>

<nav id="contents" class="contents-menu" popover aria-label="Contents">
  <ol>
    {
      nav.map((item) => (
        <li>
          <a href={item.href} onclick="document.getElementById('contents').hidePopover()">
            {item.label}
          </a>
        </li>
      ))
    }
    <li><a href="/work/alphv-group/">ALPHV Group of Companies</a></li>
    <li><a href="/work/developer-kaki/">Developer Kaki</a></li>
    <li><a href="/media-kit/">Media kit</a></li>
  </ol>
  <div class="menu-actions">
    <a class="btn-whatsapp menu-btn" href={WHATSAPP} rel="noopener" target="_blank">Message on WhatsApp</a>
    <a class="btn-linkedin menu-btn" href={LINKEDIN} rel="me noopener" target="_blank">Connect on LinkedIn</a>
  </div>
</nav>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: calc(48 * var(--u));
    height: var(--nav-h);
    padding-inline: var(--gutter) calc(67 * var(--u));
    background: var(--color-paper);
  }

  .wordmark {
    margin-right: auto;
    font-weight: 700;
    font-size: max(calc(34 * var(--u)), 18px);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-nav ul {
    display: flex;
    gap: calc(48 * var(--u));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    font-weight: 500;
    font-size: max(calc(20 * var(--u)), 13px);
    color: var(--color-ink);
    text-decoration: none;
    padding-block: 0.5em;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 260ms var(--ease-out-expo);
  }

  .site-nav a:hover {
    background-size: 100% 1px;
  }

  /* For organisers: the media kit, set apart from the section links by a hairline. */
  .header-kit {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-left: calc(4 * var(--u));
    padding: 0.5em 0 0.5em calc(48 * var(--u));
    border-left: 1px solid var(--color-rule-soft);
    font-weight: 600;
    font-size: max(calc(20 * var(--u)), 13px);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .header-kit svg {
    width: 1.15em;
    height: 1.15em;
    transition: transform 260ms var(--ease-out-expo);
  }

  .header-kit:hover,
  .header-kit[aria-current='page'] {
    color: var(--color-plate);
  }

  .header-kit:hover svg {
    transform: translateY(2px);
  }

  .wordmark,
  .site-nav a,
  .header-wa,
  .header-cta {
    white-space: nowrap;
  }

  /* Narrow desktops: the header holds nine items, so the spacing tightens before anything wraps. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .site-header,
    .site-nav ul {
      gap: calc(32 * var(--u));
    }

    .header-kit {
      padding-left: calc(32 * var(--u));
    }
  }

  .header-wa {
    margin-left: calc(28 * var(--u));
    height: calc(43 * var(--u));
    min-height: 34px;
    padding-inline: max(calc(18 * var(--u)), 14px);
    font-size: max(calc(18 * var(--u)), 13px);
  }

  .header-cta {
    height: calc(43 * var(--u));
    min-height: 34px;
    padding-inline: max(calc(18 * var(--u)), 14px);
    font-size: max(calc(18 * var(--u)), 13px);
  }

  .contents-toggle {
    display: none;
    height: 38px;
    padding-inline: 12px;
    border: 1px solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
  }

  .contents-menu {
    inset: var(--nav-h) 0 auto 0;
    width: 100%;
    margin: 0;
    padding: 8px var(--gutter) 24px;
    border: 0;
    border-bottom: 1px solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .contents-menu ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contents-menu ol a {
    display: block;
    padding-block: 14px;
    border-bottom: 1px solid var(--color-rule-soft);
    font-weight: 700;
    font-stretch: 90%;
    font-size: 24px;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .menu-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 20px;
  }

  .menu-btn {
    height: 52px;
    padding-inline: 16px;
    font-size: 16px;
  }

  .contents-menu::backdrop {
    background: color-mix(in oklab, var(--color-ink) 30%, transparent);
  }

  @media (max-width: 1023px) {
    .site-header {
      gap: 8px;
    }
    .site-nav,
    .header-kit,
    .header-wa {
      display: none;
    }
    .contents-toggle {
      display: inline-flex;
      align-items: center;
    }
    .header-cta {
      margin-left: 0;
      height: 38px;
    }
  }

  @media (max-width: 420px) {
    .header-cta {
      padding-inline: 10px;
      font-size: 13px;
    }
  }
</style>
