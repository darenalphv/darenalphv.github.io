---
// The hand-off at the end of a segment review: the other segment, set large.
interface Props {
  slug: string;
  name: string;
  line: string;
}
const { slug, name, line } = Astro.props;
---

<nav class="next" aria-label="Next segment review">
  <a href={`/work/${slug}/`}>
    <span class="label">Next segment review</span>
    <span class="name">{name}</span>
    <span class="line">{line}</span>
    <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
  </a>
</nav>

<style>
  .next a {
    display: grid;
    grid-template-columns: calc(411 * var(--u)) 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 0;
    row-gap: calc(14 * var(--u));
    padding: calc(80 * var(--u)) var(--gutter);
    border-top: max(calc(2 * var(--u)), 1px) solid var(--color-ink);
    color: var(--color-ink);
    text-decoration: none;
  }

  .label {
    grid-row: 1 / span 2;
    font-weight: 700;
    font-size: max(calc(30 * var(--u)), 18px);
    letter-spacing: -0.01em;
  }

  .name {
    font-weight: 800;
    font-stretch: 88%;
    font-size: max(calc(150 * var(--u)), 44px);
    line-height: 0.95;
    letter-spacing: -0.01em;
    transition: color 220ms var(--ease-out-expo);
  }

  .line {
    grid-column: 2;
    font-size: max(calc(28 * var(--u)), 16px);
    color: var(--color-ink-2);
  }

  .arrow {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
    width: max(calc(90 * var(--u)), 36px);
    height: max(calc(90 * var(--u)), 36px);
    transition: transform 260ms var(--ease-out-expo);
  }

  .next a:hover .name,
  .next a:hover .arrow {
    color: var(--color-plate);
  }

  .next a:hover .arrow {
    transform: translateX(8px);
  }

  @media (max-width: 1023px) {
    .next a {
      grid-template-columns: 1fr auto;
      row-gap: 8px;
      padding: 40px var(--gutter);
    }

    .label {
      grid-row: auto;
      grid-column: 1 / -1;
      font-size: 14px;
      color: var(--color-ink-2);
    }

    .line {
      grid-column: 1;
    }

    .arrow {
      grid-column: 2;
      grid-row: 2 / span 2;
    }
  }
</style>
