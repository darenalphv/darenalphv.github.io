---
// Cover for a segment review (case-study page): the home cover's grammar, without the photo.
interface Props {
  name: string;
  line: string;
  period: string;
  // the cover's point field, set for this segment
  field?: { count: number; arms: number; caption: string };
}
const { name, line, period, field } = Astro.props;
---

<section class="segment-cover on-plate" aria-labelledby="segment-name">
  {
    field && (
      <canvas
        class="field"
        aria-hidden="true"
        data-segment-field
        data-count={field.count}
        data-arms={field.arms}
      />
    )
  }
  <a class="back" href="/">Daren Tan · Annual report</a>
  <p class="period">{period}</p>
  <h1 id="segment-name" class="name">{name}</h1>
  <p class="line">{line}</p>
  {field && <p class="caption">{field.caption}</p>}
  <slot />
</section>

<script>
  import { mountCoverField } from '../scripts/cover-field';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-segment-field]');
  if (canvas) {
    const wide = window.matchMedia('(min-width: 1024px)').matches;
    mountCoverField(canvas, {
      count: Number(canvas.dataset.count),
      arms: Number(canvas.dataset.arms),
      armContrast: 0.78,
      center: wide ? [0.74, 0.5] : [0.66, 0.3],
      compWidth: 2688,
    });
  }
</script>

<style>
  .segment-cover {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-content: end;
    gap: calc(28 * var(--u));
    min-height: calc(760 * var(--u));
    padding: calc(170 * var(--u)) var(--gutter) calc(70 * var(--u));
    background: var(--color-plate);
    color: #fff;
  }

  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .caption {
    margin: 0;
    font-weight: 500;
    font-size: max(calc(22 * var(--u)), 12px);
    color: var(--color-plate-ink);
  }

  .back,
  .period {
    position: absolute;
    top: calc(52 * var(--u));
    margin: 0;
    font-weight: 500;
    font-size: max(calc(24 * var(--u)), 14px);
    color: #fff;
  }

  .back {
    left: var(--gutter);
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  .period {
    right: var(--gutter);
  }

  .name {
    margin: 0;
    font-weight: 800;
    font-stretch: 88%;
    font-size: calc(220 * var(--u));
    line-height: 0.92;
    letter-spacing: -0.01em;
  }

  .line {
    margin: 0;
    max-width: 30ch;
    font-weight: 700;
    font-stretch: 95%;
    font-size: max(calc(52 * var(--u)), 22px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  @media (max-width: 1023px) {
    .segment-cover {
      min-height: min(80svh, 620px);
      gap: 16px;
      padding: 72px var(--gutter) 32px;
    }

    .back,
    .period {
      top: 20px;
      font-size: 13px;
    }

    .period {
      right: auto;
      left: var(--gutter);
      top: 42px;
      color: var(--color-plate-ink);
    }

    .name {
      font-size: clamp(52px, 15vw, 120px);
    }
  }
</style>
