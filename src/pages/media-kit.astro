---
// Media kit for event organisers: billing, speaker bios to copy, speaker photos to download.
// Bios and photos are edited in Pages CMS (.pages.yml); the header's "Media kit" button leads here.
import Base from '../layouts/Base.astro';
import SegmentCover from '../components/SegmentCover.astro';
import SpeakerBios from '../components/kit/SpeakerBios.astro';
import SpeakerPhotos from '../components/kit/SpeakerPhotos.astro';
import { pageNode } from '../lib/schema';
---

<Base
  title="Media kit · Daren Tan, AI Speaker & Trainer in Malaysia"
  description="Media kit for Daren Tan, Malaysian AI expert, speaker and trainer and Founder & CEO of ALPHV Group of Companies: speaker bios to copy and full-size photos to download."
  schema={[pageNode('WebPage', '/media-kit/', 'Media kit: Daren Tan')]}
>
  <SegmentCover
    name="Media kit"
    line="Bios and photos of Daren Tan, AI speaker and trainer in Malaysia, ready for event organisers to copy and download."
    period="For event organisers"
    compact
  >
    <nav class="jump" aria-label="On this page">
      <a href="#bio">Speaker bio</a>
      <a href="#photos">Speaker photos</a>
    </nav>
  </SegmentCover>

  <div class="kit">
    <SpeakerBios />
    <SpeakerPhotos />
  </div>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: calc(16 * var(--u));
    margin-top: calc(12 * var(--u));
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    height: max(calc(56 * var(--u)), 40px);
    padding-inline: max(calc(22 * var(--u)), 14px);
    border: 1px solid #fff;
    color: #fff;
    font-weight: 600;
    font-size: max(calc(20 * var(--u)), 14px);
    text-decoration: none;
    transition: background-color 180ms var(--ease-out-expo), color 180ms var(--ease-out-expo);
  }

  .jump a:hover {
    background: #fff;
    color: var(--color-plate);
  }

  .kit {
    padding: calc(110 * var(--u)) var(--gutter) calc(160 * var(--u));
  }

  /* Each block opens with a strong ink rule, its side head in the report's 411-unit column. */
  .kit :global(.kit-block) {
    display: grid;
    grid-template-columns: calc(411 * var(--u)) minmax(0, 1fr);
    align-items: start;
    padding-top: calc(28 * var(--u));
    border-top: max(calc(2 * var(--u)), 1px) solid var(--color-ink);
    scroll-margin-top: var(--nav-h);
  }

  .kit :global(.kit-block + .kit-block) {
    margin-top: calc(140 * var(--u));
  }

  .kit :global(.side) {
    padding-right: calc(40 * var(--u));
  }

  .kit :global(.side-heading) {
    margin: 0;
    font-weight: 700;
    font-size: max(calc(30 * var(--u)), 18px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .kit :global(.side-sub) {
    margin: calc(8 * var(--u)) 0 0;
    font-size: max(calc(22 * var(--u)), 14px);
    line-height: 1.4;
    color: var(--color-ink-2);
  }

  /* Copy and download: square ink outline buttons that invert on hover. */
  .kit :global(.kit-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    height: max(calc(56 * var(--u)), 40px);
    padding-inline: max(calc(22 * var(--u)), 14px);
    border: 1px solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-weight: 600;
    font-size: max(calc(20 * var(--u)), 14px);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 180ms var(--ease-out-expo), color 180ms var(--ease-out-expo);
  }

  .kit :global(.kit-btn svg) {
    width: 1.1em;
    height: 1.1em;
    flex: none;
  }

  .kit :global(.kit-btn:hover) {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .kit :global(.kit-btn:active) {
    transform: translateY(1px);
  }

  @media (max-width: 1023px) {
    .kit {
      padding: 40px var(--gutter) 72px;
    }

    .kit :global(.kit-block) {
      grid-template-columns: 1fr;
      row-gap: 20px;
      padding-top: 16px;
      border-top-width: 2px;
    }

    .kit :global(.kit-block + .kit-block) {
      margin-top: 56px;
    }
  }
</style>
