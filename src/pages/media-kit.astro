---
// Media kit for event organisers: billing, speaker bios to copy, speaker photos to download.
// Bios and photos are edited in Pages CMS (.pages.yml); the header's "Media kit" button leads here.
import Base from '../layouts/Base.astro';
import SegmentCover from '../components/SegmentCover.astro';
import SpeakerBios from '../components/kit/SpeakerBios.astro';
import SpeakerPhotos from '../components/kit/SpeakerPhotos.astro';
import { pageNode } from '../lib/schema';
---

<Base
  title="Media kit · Daren Tan, AI Speaker & Trainer in Malaysia"
  description="Media kit for Daren Tan, Malaysian AI expert, speaker and trainer and Founder & CEO of ALPHV Group of Companies: speaker bios to copy and full-size photos to download."
  schema={[pageNode('WebPage', '/media-kit/', 'Media kit: Daren Tan')]}
>
  <SegmentCover
    name="Media kit"
    line="Bios and photos of Daren Tan, AI speaker and trainer in Malaysia, ready for event organisers to copy and download."
    period="For event organisers"
    compact
  >
    <nav class="jump" aria-label="On this page">
      <a href="#bio">Speaker bio</a>
      <a href="#photos">Speaker photos</a>
    </nav>
  </SegmentCover>

  <div class="kit">
    <SpeakerBios />
    <SpeakerPhotos />
  </div>
</Base>
